# Copy to .env and fill in. Never commit the real .env - it is gitignored.

# MongoDB Atlas connection string, including the database name.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fiverr?retryWrites=true&w=majority

# Secret used to sign auth tokens. Generate a long random one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEC=

# Comma-separated list of browser origins allowed to call this API with
# cookies. No trailing slash. Example:
#   CLIENT_URL=http://localhost:3000,https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# Must be "production" on the host, or auth cookies are issued without
# SameSite=None/Secure and cross-site login silently fails.
NODE_ENV=development

# Stripe secret key (sk_test_... or sk_live_...).
STRIPE_SECRET_KEY=

# Cloudinary, used by POST /api/upload.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
